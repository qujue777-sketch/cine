{
  // Cloudflare Workers 静态资源部署配置
  // 用于 Git 集成构建：npm run build 产出 dist 后，由 wrangler 上传为静态站点
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cine",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
